{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-state.schema.json",
  "title": "Project State",
  "type": "object",
  "required": ["schema_version", "project", "workflow"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "required": ["name", "summary"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "required": ["current_stage", "next_stage", "stage_records", "completed_stages"],
      "properties": {
        "current_stage": {"type": ["string", "null"]},
        "next_stage": {"type": ["string", "null"]},
        "stage_records": {"type": "object"},
        "completed_stages": {"type": "array"}
      },
      "additionalProperties": true
    },
    "sources": {"type": "array"},
    "decisions": {"type": "array"},
    "assumptions": {"type": "array"},
    "risks": {"type": "array"},
    "open_questions": {"type": "array"},
    "conflicts": {"type": "array"},
    "evidence": {"type": "array"},
    "review_findings": {"type": "array"}
  },
  "additionalProperties": true
}
