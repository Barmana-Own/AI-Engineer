# Never commit a real API key.

APP_ENVIRONMENT=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8010
GATEWAY_LOG_LEVEL=INFO

BARMANA_BASE_URL=https://api.codemain.ir/v2/api
BARMANA_API_KEY=YOUR_API_KEY
BARMANA_AUTH_MODE=bearer
BARMANA_MODELS_PATH=/models
BARMANA_CHAT_PATH=/chat/completions

# Optional OpenAI-compatible provider pool. Keep this JSON in the local .env
# only; use api_key_env so credentials never appear in the JSON value.
# Providers are addressed as provider/model (for example openrouter/openai/gpt-4o-mini).
PROVIDER_PROFILES_JSON={"openrouter":{"base_url":"https://openrouter.ai/api/v1","api_key_env":"OPENROUTER_API_KEY","default_model":"openai/gpt-4o-mini","fallback_models":"google/gemini-2.5-flash,anthropic/claude-3.7-sonnet"},"gemini":{"base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key_env":"GEMINI_API_KEY","default_model":"gemini-2.5-flash"},"openai":{"base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_API_KEY","default_model":"gpt-4o-mini"}}

CONNECT_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=90
WRITE_TIMEOUT_SECONDS=30
POOL_TIMEOUT_SECONDS=10
MAX_RETRIES=1
RETRY_BASE_DELAY_SECONDS=0.5

MODEL_CACHE_TTL_SECONDS=300

DEFAULT_MODEL=mistral-small-latest
FALLBACK_MODELS=mistral-medium-latest,auto,codestral-latest
MAX_FALLBACK_ATTEMPTS=3
DEFAULT_MAX_TOKENS=1024
HARD_MAX_TOKENS=8192
