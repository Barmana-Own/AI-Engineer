APP_NAME=AI Engineer Orchestrator
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8012
MODEL_GATEWAY_URL=http://127.0.0.1:8010
LOCAL_AGENT_URL=http://127.0.0.1:8011
AGENT_MODEL=qwen2.5-coder:3b
AUTONOMOUS_AGENT_MODEL=qwen2.5-coder:1.5b

# Explicit API calls can start bounded self-improvement runs.
# Set true only when the project should wake itself periodically.
AUTONOMOUS_MODE_ENABLED=false
AUTONOMOUS_INTERVAL_MINUTES=1
AUTONOMOUS_CYCLES_PER_RUN=1

AUTONOMOUS_WORKSPACE=ai-engineer
AUTONOMOUS_SUBAGENTS=planner,implementer,verifier
AUTONOMOUS_MAX_SUBAGENTS=4
AUTONOMOUS_TASK_TIMEOUT_SECONDS=360
AUTONOMOUS_MODEL_TIMEOUT_SECONDS=180

# Verified autonomous checkpoints are pushed to this exact repository only.
AUTONOMOUS_AUTO_PUSH=false
# Optional override; defaults to AI_ENGINE_PROJECT_ROOT or repository discovery.
# AUTONOMOUS_REPO_ROOT=C:\\Projects\\AI-Engineer
# AI_ENGINE_PROJECT_ROOT=C:\\Projects\\AI-Engineer
AUTONOMOUS_GIT_REMOTE=https://github.com/Barmana-Own/AI-Engineer.git

AUTONOMOUS_READ_PARALLELISM=2
AUTONOMOUS_RECONCILIATION_GRACE_SECONDS=900